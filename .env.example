APP_NAME=Open Inserto
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
DATABASE_URL=sqlite:///data/open_inserto.db
EBAY_MODE=sandbox
EBAY_MARKETPLACE_ID=EBAY_DE
EBAY_CONTENT_LANGUAGE=de-DE
EBAY_CURRENCY=EUR
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_RU_NAME=your-ebay-runame
EBAY_AUTH_CALLBACK_URL=http://localhost:8000/integrations/ebay/callback
# Optional fallback only. After first-time auth, tokens are stored by the app itself.
EBAY_ACCESS_TOKEN=
EBAY_REFRESH_TOKEN=
EBAY_PAYMENT_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=
