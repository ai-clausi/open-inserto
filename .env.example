APP_NAME=Open Inserto
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
DATABASE_URL=sqlite:///data/open_inserto.db
EBAY_MODE=sandbox
EBAY_MARKETPLACE_ID=EBAY_DE
EBAY_CONTENT_LANGUAGE=de-DE
EBAY_CURRENCY=EUREBAY_SANDBOX_CLIENT_ID=your-sandbox-client-id
EBAY_SANDBOX_CLIENT_SECRET=your-sandbox-client-secret
EBAY_SANDBOX_RU_NAME=your-sandbox-runame
EBAY_LIVE_CLIENT_ID=your-live-client-id
EBAY_LIVE_CLIENT_SECRET=your-live-client-secret
EBAY_LIVE_RU_NAME=your-live-runame

DRAFT_ANALYSIS_BACKEND=auto
VISION_PROVIDER=openai
VISION_MODEL=gpt-4.1-mini
VISION_API_KEY=your-openai-api-key
VISION_TIMEOUT_SECONDS=30
